#!/usr/bin/env python3
"""Abre o OpenRGB (bandeja + servidor) com os efeitos de audio do gabinete.

1. O Effects Plugin escolhe a entrada de audio pelo indice na lista do
   OpenAL, e esse indice muda quando dispositivos USB de audio entram ou
   saem. Antes de abrir o OpenRGB, acha a entrada virtual "RGB Audio"
   (PipeWire) e grava o indice atual no perfil.
2. Depois de abrir, confere pelo SDK o tamanho das zonas ARGB (fitas nao
   informam quantos LEDs tem) e corrige o que estiver diferente; o OpenRGB
   guarda o tamanho no Configuration.json.
3. Vigia o OpenRGB: o Effects Plugin as vezes aborta ao trocar de perfil
   (corrida entre a thread de um efeito e a desmontagem da captura de
   audio). Se o OpenRGB morrer com erro, abre de novo; se fechar
   normalmente (sair pela bandeja), respeita.
4. SIGTERM neste processo (o "Sair" do rgb-casa) = desligar de proposito:
   encerra o OpenRGB e sai sem reabrir.
5. O OpenRGB roda escondido (plataforma "offscreen" do Qt: sem janela e sem
   icone na bandeja); quem aparece para o usuario e o rgb-casa.
"""
import ctypes
import json
import os
import signal
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import rgb_config  # noqa: E402
from rgbsdk import SDK  # noqa: E402

PROFILE = os.path.expanduser("~/.config/OpenRGB/profiles/Gabinete.json")
ZONES = os.path.expanduser("~/.config/rgb-gabinete/zonas.json")
PLUGIN = "OpenRGB Effects Plugin"
SOURCE = "RGB Audio"


def log(msg):
    print(f"openrgb-gabinete: {msg}", file=sys.stderr, flush=True)


# ---------------------------------------------------------------------------
# Entrada de audio
# ---------------------------------------------------------------------------
def openal_capture_devices():
    al = ctypes.CDLL("libopenal.so.1")
    al.alcGetString.restype = ctypes.c_void_p
    al.alcGetString.argtypes = [ctypes.c_void_p, ctypes.c_int]
    p = al.alcGetString(None, 0x310)            # ALC_CAPTURE_DEVICE_SPECIFIER
    out = []
    while p and (s := ctypes.string_at(p)):
        out.append(s.decode(errors="replace"))
        p += len(s) + 1
    return out


def fix_audio_device():
    # o PipeWire pode ainda estar subindo logo apos o login
    for _ in range(30):
        devices = openal_capture_devices()
        if SOURCE in devices:
            break
        time.sleep(1)
    else:
        log(f"entrada '{SOURCE}' nao encontrada")
        return
    idx = devices.index(SOURCE)
    try:
        with open(PROFILE) as f:
            prof = json.load(f)
    except (OSError, json.JSONDecodeError) as e:
        log(f"perfil ilegivel: {e}")
        return
    changed = False
    for eff in prof.get("plugins", {}).get(PLUGIN, {}).get("Effects", []):
        audio = eff.get("CustomSettings", {}).get("audio_settings")
        if audio is not None and audio.get("audio_device") != idx:
            audio["audio_device"] = idx
            changed = True
    if changed:
        tmp = PROFILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(prof, f, indent=4)
        os.replace(tmp, PROFILE)


def fix_zone_sizes(timeout=90):
    try:
        with open(ZONES) as f:
            wanted = json.load(f)
    except (OSError, json.JSONDecodeError):
        return
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            sdk = SDK("openrgb-gabinete")
            ctrls = sdk.controllers()
            if all(any(w["match"] in c.name for c in ctrls) for w in wanted):
                break
        except OSError:
            pass
        time.sleep(3)                             # servidor subindo / deteccao em curso
    else:
        log("OpenRGB nao detectou todos os controladores a tempo")
        return
    for w in wanted:
        for c in ctrls:
            if w["match"] not in c.name or w["zone"] >= len(c.zones):
                continue
            z = c.zones[w["zone"]]
            if z.count != w["size"] and z.min <= w["size"] <= z.max:
                log(f"{c.name} / {z.name}: {z.count} -> {w['size']} LEDs")
                sdk.resize_zone(c.index, w["zone"], w["size"])


MAX_RESTARTS, RESTART_WINDOW, RESTART_DELAY = 5, 300, 3
STOP_TIMEOUT = 10


class Stop(Exception):
    """Pedido de desligar de proposito (SIGTERM)."""


def _on_term(*_):
    raise Stop()


def stop_child(proc):
    """Encerra o OpenRGB: pede com SIGTERM e so forca se nao sair a tempo."""
    if proc is None or proc.poll() is not None:
        return
    proc.terminate()
    try:
        proc.wait(STOP_TIMEOUT)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()


CURRENT = {"proc": None}


def run_once():
    fix_audio_device()
    env = dict(os.environ, QT_QPA_PLATFORM="offscreen")
    proc = subprocess.Popen(["openrgb", "--startminimized", "--server"], env=env)
    CURRENT["proc"] = proc
    try:
        fix_zone_sizes()
        if rgb_config.uses_screen(rgb_config.user_config()):
            # cada inicio do efeito de tela gasta o token do portal: salva o novo
            rgb_config.persist_screen_token(rgb_config.PROFILE, delay=20)
    except Exception as e:                        # nunca derrubar o OpenRGB por isso
        log(f"falha ao conferir as zonas/token da tela: {e}")
    return proc.wait()


def supervise(run=run_once, sleep=time.sleep, clock=time.monotonic):
    """Reabre o OpenRGB se ele morrer com erro; desiste se cair demais."""
    crashes = []
    while True:
        code = run()
        if code == 0:                             # saiu normalmente
            return 0
        now = clock()
        crashes = [t for t in crashes if now - t < RESTART_WINDOW] + [now]
        if len(crashes) > MAX_RESTARTS:
            log(f"OpenRGB caiu {len(crashes)} vezes em {RESTART_WINDOW // 60} min; parando de reabrir")
            return code
        log(f"OpenRGB terminou com codigo {code}; reabrindo em {RESTART_DELAY} s")
        sleep(RESTART_DELAY)


def main():
    signal.signal(signal.SIGTERM, _on_term)
    try:
        return supervise()
    except Stop:
        stop_child(CURRENT["proc"])
        log("desligado a pedido")
        return 0


if __name__ == "__main__":
    sys.exit(main())
