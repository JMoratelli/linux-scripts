#!/usr/bin/env python3
"""dota-rgb: teclado e WLED da mesa seguindo o Dota 2.

- Dota abriu  -> carrega o perfil "Dota" do OpenRGB: os fans e o resto do
                 gabinete continuam com os efeitos de audio, e o teclado e a
                 WLED ficam sem efeito do plugin para este programa pintar
- Dota fechou -> volta para o perfil "Gabinete"

O estado da partida chega pelo Game State Integration do Dota (arquivo em
game/dota/cfg/gamestate_integration/ + opcao de inicializacao
-gamestateintegration, ver leds.sh) num servidor HTTP em 127.0.0.1:3000.

Teclado: so as teclas de acao acendem (Q W E D F R habilidades, Z X C V B N
itens), o resto fica apagado. So duas cores: verde = da para usar; vermelho =
recarga, sem mana ou bloqueada.
WLED: a fita inteira na cor da vida (verde -> amarelo -> vermelho); dano =
pulso (apaga um instante e acende vermelho puro); cura grande = brilho verde;
morto = vermelho vibrante e depois um scanner vermelho indo e voltando ate
renascer, quando a fita pisca verde; fora da partida, respiracao fraca.
O ultimo estado recebido fica em ~/.cache/dota-rgb/gsi.json (diagnostico).
"""
import json
import math
import os
import sys
import threading
import time
from colorsys import hsv_to_rgb
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import rgb_config  # noqa: E402
from rgbsdk import SDK  # noqa: E402

GSI_ADDR = ("127.0.0.1", 3000)
FPS = 20
PROFILE_GAME, PROFILE_NORMAL = "Dota", "Gabinete"
PROCESS = "dota2"
GSI_TIMEOUT = 40                  # sem dados do jogo ha tanto tempo = menu
DUMP = os.path.expanduser("~/.cache/dota-rgb/gsi.json")

# posicao de cada tecla no quadro do K629 (coluna*6 + linha)
KEY = {"Q": 8, "W": 14, "E": 20, "R": 26, "D": 21, "F": 27,
       "Z": 10, "X": 16, "C": 22, "V": 28, "B": 34, "N": 40}
ABILITY_KEYS = [KEY[k] for k in "QWEDF"]          # na ordem do GSI; ultimate vai no R
ULT_KEY = KEY["R"]
ITEM_KEYS = [KEY[k] for k in "ZXCVBN"]

GAME_DEVICES = ("Redragon K629", "WLED Mesa")     # o resto fica com os efeitos de audio
READY, BLOCKED = (0, 255, 0), (255, 0, 0)          # teclado: so verde e vermelho
DEAD = (60, 0, 0)
MENU = (200, 30, 0)                               # vermelho do Dota respirando


def scale(c, k):
    return tuple(max(0, min(255, int(v * k))) for v in c)


def lerp(a, b, t):
    return tuple(int(x + (y - x) * t) for x, y in zip(a, b))


def hsv(h, s, v):
    return tuple(int(c * 255) for c in hsv_to_rgb(h, s, v))


class GSI:
    """Guarda o ultimo estado enviado pelo Dota."""

    def __init__(self):
        self.state, self.stamp = {}, 0.0
        self.lock = threading.Lock()
        gsi = self

        class Handler(BaseHTTPRequestHandler):
            def do_POST(self):
                n = int(self.headers.get("Content-Length", 0))
                try:
                    data = json.loads(self.rfile.read(n) or b"{}")
                except json.JSONDecodeError:
                    data = None
                if data is not None:
                    with gsi.lock:
                        gsi.state, gsi.stamp = data, time.monotonic()
                    gsi.dump(data)
                self.send_response(200)
                self.end_headers()

            def log_message(self, *args):
                pass

        server = ThreadingHTTPServer(GSI_ADDR, Handler)
        threading.Thread(target=server.serve_forever, daemon=True).start()

    def dump(self, data):
        now = time.monotonic()
        if now - getattr(self, "last_dump", 0) < 2:
            return
        self.last_dump = now
        try:
            os.makedirs(os.path.dirname(DUMP), exist_ok=True)
            with open(DUMP + ".tmp", "w") as f:
                json.dump(data, f, indent=1)
            os.replace(DUMP + ".tmp", DUMP)
        except OSError:
            pass

    def get(self):
        with self.lock:
            fresh = time.monotonic() - self.stamp < GSI_TIMEOUT
            return self.state if fresh else {}


def dota_running():
    for pid in os.listdir("/proc"):
        if pid.isdigit():
            try:
                with open(f"/proc/{pid}/comm") as f:
                    if f.read().strip() == PROCESS:
                        return True
            except OSError:
                pass
    return False


class Painter:
    @staticmethod
    def slot_color(slot):
        """Verde = da para usar; vermelho = recarga, sem mana ou bloqueada;
        apagada = nao aprendida / slot vazio. Passiva conta como disponivel."""
        if slot.get("level", 1) == 0 or slot.get("name") in (None, "empty"):
            return (0, 0, 0)
        if slot.get("passive"):
            return READY
        if (slot.get("cooldown", 0) or 0) > 0 or not slot.get("can_cast", True):
            return BLOCKED
        return READY

    def keyboard(self, state, n, now):
        hero = state.get("hero", {})
        px = [(0, 0, 0)] * n                     # so as teclas de acao acendem
        if hero and not hero.get("alive", True):
            return [DEAD] * n
        abilities = [a for _, a in sorted(state.get("abilities", {}).items())
                     if isinstance(a, dict) and not a.get("name", "").startswith(("generic_hidden", "plus_"))]
        normal = [a for a in abilities if not a.get("ultimate")]
        for key, a in zip(ABILITY_KEYS, normal):
            px[key] = self.slot_color(a)
        ult = next((a for a in abilities if a.get("ultimate")), None)
        if ult:
            px[ULT_KEY] = self.slot_color(ult)
        items = state.get("items", {})
        for i, key in enumerate(ITEM_KEYS):
            slot = items.get(f"slot{i}")
            if isinstance(slot, dict):
                px[key] = self.slot_color(slot)
        return px


class HealthBar:
    """WLED: cor da vida na fita inteira, flash de dano/cura; na morte, vermelho
    vibrante e depois um scanner vermelho indo e voltando; ao renascer, pisca
    verde."""

    DEATH_RED = 2.0                  # segundos de vermelho vibrante ao morrer
    RESPAWN_BLINK = 1.0              # segundos piscando verde ao renascer
    HIT_GAP, HIT_FADE = 0.08, 0.6    # pulso de dano: apaga, vermelho puro, volta

    def __init__(self):
        self.last_hp = None
        self.hit_at = None           # inicio do ultimo pulso de dano
        self.heal = 0.0              # intensidade do brilho verde (0..1)
        self.died_at = None
        self.born_at = None

    def render(self, hero, n, now):
        if not hero.get("alive", True):
            return self.dead(n, now)
        if self.died_at is not None:                 # acabou de renascer
            self.died_at, self.born_at = None, now
        if self.born_at is not None and now - self.born_at < self.RESPAWN_BLINK:
            on = int((now - self.born_at) / (self.RESPAWN_BLINK / 4)) % 2 == 0
            return [(0, 255, 0) if on else (0, 0, 0)] * n
        hp = (hero.get("health_percent", 0) or 0) / 100
        if self.last_hp is not None:
            delta = hp - self.last_hp
            if delta <= -0.01:
                self.hit_at = now                    # qualquer dano reinicia o pulso
            elif delta > 0.10:
                self.heal = 1.0
        self.last_hp = hp
        c = hsv(hp / 3, 1.0, 1.0)                    # vida: verde (120) -> vermelho (0)
        if self.hit_at is not None:
            t = now - self.hit_at
            if t < self.HIT_GAP:
                return [(0, 0, 0)] * n               # apaga um instante: pulso bem visivel
            if t < self.HIT_GAP + self.HIT_FADE:
                return [lerp((255, 0, 0), c, (t - self.HIT_GAP) / self.HIT_FADE)] * n
            self.hit_at = None
        if self.heal:
            c = lerp(c, (0, 255, 60), self.heal * 0.6)
        self.heal = max(0.0, self.heal - 0.06)
        return [c] * n

    def dead(self, n, now):
        self.last_hp = None
        if self.died_at is None:
            self.died_at = now
        t = now - self.died_at
        if t < self.DEATH_RED:
            return [(255, 0, 0)] * n
        return self.scanner(n, t - self.DEATH_RED)

    @staticmethod
    def scanner(n, t, speed=1.2, tail=10):
        """Ponto vermelho com rastro indo e voltando pela fita."""
        span = max(1, n - 1)
        phase = (t * speed) % 2
        head = phase * span if phase < 1 else (2 - phase) * span
        out = []
        for i in range(n):
            d = abs(i - head)
            out.append(scale((255, 0, 0), max(0.0, 1 - d / tail)))
        return out


def paint(sdk, ctrls, state, painter, bar, now):
    hero = state.get("hero", {})
    in_game = bool(hero) and "team_name" in state.get("player", {})
    menu = scale(MENU, 0.25 + 0.15 * (1 + math.sin(now * 1.5)))
    for c in ctrls:
        if not in_game:
            colors = [menu] * c.num_leds
        elif "Redragon" in c.name:
            colors = painter.keyboard(state, c.num_leds, now)
        else:                                                   # WLED
            colors = bar.render(hero, c.num_leds, now)
        if c.num_leds:
            sdk.update_leds(c.index, colors)


def main():
    gsi = GSI()
    painter, bar = Painter(), HealthBar()
    sdk = ctrls = None
    active = False
    period = 1.0 / FPS
    last_check = 0.0
    while True:
        now = time.monotonic()
        if now - last_check > 3:
            last_check = now
            running = dota_running()
            if active and running and sdk:
                try:                                    # OpenRGB reiniciou/trocou de perfil?
                    if sdk.active_profile() != PROFILE_GAME:
                        active = False
                except OSError:
                    sdk, active = None, False
            if running != active:
                try:
                    sdk = sdk or SDK("dota-rgb")
                    name = PROFILE_GAME if running else PROFILE_NORMAL
                    sdk.load_profile(name)
                    if rgb_config.uses_screen(rgb_config.user_config()):
                        # o Ambient pediu um token novo ao portal: salva no perfil
                        threading.Thread(target=rgb_config.persist_screen_token,
                                         args=(name,), daemon=True).start()
                    active = running
                    if running:
                        time.sleep(1)                   # plugin parando os efeitos
                        ctrls = [c for c in sdk.controllers() if c.name in GAME_DEVICES]
                        for c in ctrls:
                            sdk.custom_mode(c.index)
                    print(f"perfil -> {PROFILE_GAME if running else PROFILE_NORMAL}", flush=True)
                except OSError as e:
                    print(f"OpenRGB indisponivel: {e}", flush=True)
                    sdk = None
        if active and sdk and ctrls:
            try:
                paint(sdk, ctrls, gsi.get(), painter, bar, now)
            except OSError as e:
                print(f"conexao com OpenRGB perdida: {e}", flush=True)
                sdk, active = None, False
        time.sleep(max(0.0, period - (time.monotonic() - now)))


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
