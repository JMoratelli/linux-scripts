#!/usr/bin/env python3
"""Abre o OpenRGB (bandeja + servidor) com os efeitos de audio do gabinete.

1. O Effects Plugin escolhe a entrada de audio pelo indice na lista do
   OpenAL, e esse indice muda quando dispositivos USB de audio entram ou
   saem. Antes de abrir o OpenRGB, acha a entrada virtual "RGB Audio"
   (PipeWire) e grava o indice atual no perfil.
2. Depois de abrir, confere pelo SDK o tamanho das zonas ARGB (fitas nao
   informam quantos LEDs tem) e corrige o que estiver diferente; o OpenRGB
   guarda o tamanho no Configuration.json.
"""
import ctypes
import json
import os
import socket
import struct
import subprocess
import sys
import time

PROFILE = os.path.expanduser("~/.config/OpenRGB/profiles/Gabinete.json")
ZONES = os.path.expanduser("~/.config/rgb-gabinete/zonas.json")
PLUGIN = "OpenRGB Effects Plugin"
SOURCE = "RGB Audio"


def log(msg):
    print(f"openrgb-gabinete: {msg}", file=sys.stderr, flush=True)


# ---------------------------------------------------------------------------
# Entrada de audio
# ---------------------------------------------------------------------------
def openal_capture_devices():
    al = ctypes.CDLL("libopenal.so.1")
    al.alcGetString.restype = ctypes.c_void_p
    al.alcGetString.argtypes = [ctypes.c_void_p, ctypes.c_int]
    p = al.alcGetString(None, 0x310)            # ALC_CAPTURE_DEVICE_SPECIFIER
    out = []
    while p and (s := ctypes.string_at(p)):
        out.append(s.decode(errors="replace"))
        p += len(s) + 1
    return out


def fix_audio_device():
    # o PipeWire pode ainda estar subindo logo apos o login
    for _ in range(30):
        devices = openal_capture_devices()
        if SOURCE in devices:
            break
        time.sleep(1)
    else:
        log(f"entrada '{SOURCE}' nao encontrada")
        return
    idx = devices.index(SOURCE)
    try:
        with open(PROFILE) as f:
            prof = json.load(f)
    except (OSError, json.JSONDecodeError) as e:
        log(f"perfil ilegivel: {e}")
        return
    changed = False
    for eff in prof.get("plugins", {}).get(PLUGIN, {}).get("Effects", []):
        audio = eff.get("CustomSettings", {}).get("audio_settings")
        if audio is not None and audio.get("audio_device") != idx:
            audio["audio_device"] = idx
            changed = True
    if changed:
        tmp = PROFILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(prof, f, indent=4)
        os.replace(tmp, PROFILE)


# ---------------------------------------------------------------------------
# SDK do OpenRGB (protocolo 3): so o necessario para redimensionar zonas
# ---------------------------------------------------------------------------
class Reader:
    def __init__(self, data):
        self.d, self.o = data, 0

    def take(self, fmt):
        v = struct.unpack_from("<" + fmt, self.d, self.o)
        self.o += struct.calcsize("<" + fmt)
        return v if len(v) > 1 else v[0]

    def string(self):
        n = self.take("H")
        s = self.d[self.o:self.o + n].rstrip(b"\0").decode(errors="replace")
        self.o += n
        return s


def parse_controller(data):
    """Retorna (nome, [(nome_zona, leds, min, max)])."""
    r = Reader(data)
    r.take("Ii")                                  # tamanho, tipo
    name = r.string()
    for _ in range(5):                            # vendor, descricao, versao, serial, local
        r.string()
    nmodes = r.take("H")
    r.take("i")                                   # modo ativo
    for _ in range(nmodes):
        r.string()
        r.take("iIIIIIIIIIII")
        ncolors = r.take("H")
        r.o += 4 * ncolors
    zones = []
    for _ in range(r.take("H")):
        zname = r.string()
        _, lmin, lmax, count = r.take("iIII")
        mlen = r.take("H")
        r.o += mlen
        zones.append((zname, count, lmin, lmax))
    return name, zones


class SDK:
    def __init__(self):
        self.s = socket.create_connection(("127.0.0.1", 6742), timeout=5)
        self.send(0, 40, struct.pack("<I", 3))
        self.proto = min(3, struct.unpack("<I", self.recv(40))[0])
        self.send(0, 50, b"openrgb-gabinete\0")

    def send(self, dev, pkt, data=b""):
        self.s.sendall(b"ORGB" + struct.pack("<III", dev, pkt, len(data)) + data)

    def _exact(self, n):
        buf = b""
        while len(buf) < n:
            chunk = self.s.recv(n - len(buf))
            if not chunk:
                raise ConnectionError("OpenRGB fechou a conexao")
            buf += chunk
        return buf

    def recv(self, want):
        while True:
            _, _, pkt, size = struct.unpack("<4sIII", self._exact(16))
            data = self._exact(size)
            if pkt == want:
                return data

    def controllers(self):
        self.send(0, 0)
        n = struct.unpack("<I", self.recv(0))[0]
        out = []
        for i in range(n):
            self.send(i, 1, struct.pack("<I", self.proto))
            out.append(parse_controller(self.recv(1)))
        return out

    def resize_zone(self, dev, zone, size):
        self.send(dev, 1000, struct.pack("<ii", zone, size))


def fix_zone_sizes(timeout=90):
    try:
        with open(ZONES) as f:
            wanted = json.load(f)
    except (OSError, json.JSONDecodeError):
        return
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            sdk = SDK()
            ctrls = sdk.controllers()
            if all(any(w["match"] in name for name, _ in ctrls) for w in wanted):
                break
        except OSError:
            pass
        time.sleep(3)                             # servidor subindo / deteccao em curso
    else:
        log("OpenRGB nao detectou todos os controladores a tempo")
        return
    for w in wanted:
        for dev, (name, zones) in enumerate(ctrls):
            if w["match"] not in name or w["zone"] >= len(zones):
                continue
            zname, count, lmin, lmax = zones[w["zone"]]
            if count != w["size"] and lmin <= w["size"] <= lmax:
                log(f"{name} / {zname}: {count} -> {w['size']} LEDs")
                sdk.resize_zone(dev, w["zone"], w["size"])


if __name__ == "__main__":
    fix_audio_device()
    proc = subprocess.Popen(["openrgb", "--startminimized", "--server"])
    try:
        fix_zone_sizes()
    except Exception as e:                        # nunca derrubar o OpenRGB por isso
        log(f"falha ao conferir as zonas: {e}")
    sys.exit(proc.wait())
